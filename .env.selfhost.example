# Self-host bundle settings for infra/docker/up.sh (real MiroFish) and infra/docker/up-mock.sh (mock). Copy to .env.selfhost and fill in the blanks; compose refuses to start until BETTER_AUTH_SECRET, MIROFISH_TOKEN, POSTGRES_PASSWORD and MINIO_ROOT_PASSWORD are set.

# Image tag pulled from ghcr.io/xenetdev/xenet-opinions-*; images that are not published are built locally.
# On a tagged checkout set this to that tag, e.g. v0.1.0
XO_IMAGE_TAG=edge

XO_WEB_PORT=3000
# Set these only when the app is served from another origin; both default to http://localhost:${XO_WEB_PORT}
# NEXT_PUBLIC_APP_URL=
# BETTER_AUTH_URL=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Generate with: openssl rand -hex 32 (shared by the proxy, web and worker)
MIROFISH_TOKEN=
# Language MiroFish writes personas, posts, interviews and the report in: en, zh, es, fr, pt, ru or de
MIROFISH_LOCALE=en

# Generate with: openssl rand -hex 32 (compose builds DATABASE_URL from it, so keep it URL-safe)
POSTGRES_PASSWORD=

# The user needs at least 3 characters. Generate the password with: openssl rand -hex 24 (at least 8 characters)
MINIO_ROOT_USER=xo-admin
MINIO_ROOT_PASSWORD=

# Required for the real MiroFish (up.sh). LLM_API_KEY is any OpenAI-compatible key; ZEP_API_KEY is a Zep Cloud key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=

# Mock MiroFish only (up-mock.sh): divides the mock's delays.
MOCK_SPEED=5
# MOCK_INTERVIEW_DELAY_MS=1500

DEMO_MODE=0
DEMO_PAUSED=0
# 0 hides the "Pause for interviews" toggle
# DEMO_ALLOW_PAUSE=1
MAX_RUNS_PER_DAY=2
DEMO_MAX_ROUNDS=3
ENV_KEEPALIVE_MS=1200000
ENV_SWEEP_INTERVAL_MS=60000
