# Self-host bundle settings for infra/docker/docker-compose.yml. Copy to .env.selfhost and fill in the blanks; compose refuses to start until BETTER_AUTH_SECRET, MIROFISH_TOKEN, POSTGRES_PASSWORD and MINIO_ROOT_PASSWORD are set.

# mock: bundled mock MiroFish, no keys needed. real: upstream MiroFish (set LLM_API_KEY and ZEP_API_KEY).
COMPOSE_PROFILES=mock
# Must match the profile: mirofish-mock:5001 for mock, mirofish:5001 for real.
MIROFISH_UPSTREAM=mirofish-mock:5001
# MIROFISH_UPSTREAM=mirofish:5001

XO_WEB_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Generate with: openssl rand -hex 32 (shared by the proxy, web and worker)
MIROFISH_TOKEN=

# Generate with: openssl rand -hex 32 (compose builds DATABASE_URL from it, so keep it URL-safe)
POSTGRES_PASSWORD=

# The user needs at least 3 characters. Generate the password with: openssl rand -hex 24 (at least 8 characters)
MINIO_ROOT_USER=xo-admin
MINIO_ROOT_PASSWORD=

# Real profile only. LLM_API_KEY is any OpenAI-compatible key; ZEP_API_KEY is a Zep Cloud key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
ZEP_API_KEY=

# Mock profile only: divides the mock's delays.
MOCK_SPEED=5

DEMO_MODE=0
DEMO_PAUSED=0
MAX_RUNS_PER_DAY=2
DEMO_MAX_ROUNDS=3
ENV_KEEPALIVE_MS=1200000
ENV_SWEEP_INTERVAL_MS=60000
