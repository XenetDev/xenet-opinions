{
  "name": "xenet-opinions",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome ci .",
    "mock": "pnpm --filter @xo/mirofish mock",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "check:licenses": "node scripts/check-licenses.mjs",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
