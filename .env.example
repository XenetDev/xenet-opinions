XO_PG_PORT=5432
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MIROFISH_URL=http://localhost:5001
MIROFISH_TOKEN=
HEALTH_CHECK_MIROFISH=1
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_BUCKET=
