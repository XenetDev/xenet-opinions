DATABASE_URL=postgresql://xo:xo@localhost:5432/xo
# Optional: base name for per-package test databases; DB tests skip when neither this nor DATABASE_URL is set
TEST_DATABASE_URL=postgresql://xo:xo@localhost:5432/xo_test
XO_PG_PORT=5432
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
MIROFISH_URL=http://localhost:5001
MIROFISH_TOKEN=
MIROFISH_LOCALE=en
HEALTH_CHECK_MIROFISH=1
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
# 1 sends browser uploads straight to the S3 bucket (needs a browser-reachable S3_ENDPOINT and bucket CORS); ignored for local
STORAGE_DIRECT_UPLOADS=1
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
WORKER_POLL_MS=2000
MAX_CONCURRENT_RUNS=1
# Optional: lease owner name for this worker; defaults to <hostname>-<pid>. Leave commented, an empty value fails validation
# WORKER_ID=
ENV_KEEPALIVE_MS=1200000
ENV_SWEEP_INTERVAL_MS=60000
DEMO_MODE=0
DEMO_PAUSED=0
DEMO_ALLOW_PAUSE=1
MAX_RUNS_PER_DAY_ANONYMOUS=1
MAX_RUNS_PER_DAY=3
DEMO_MAX_ROUNDS=3

# Optional sign-in. Without RESEND_API_KEY the dev server prints magic links to its terminal
# RESEND_API_KEY=
# Name <address> or a bare address on a domain verified in Resend
# EMAIL_FROM=
# Google Cloud console OAuth client; redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub OAuth app; callback URL is <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Apple Sign in with Apple; needs both, the bundle identifier is optional
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
