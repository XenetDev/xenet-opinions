FROM node:24-slim
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 COREPACK_HOME=/opt/corepack NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@10.30.0 --activate && chmod -R a+rX /opt/corepack
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/engine/package.json packages/engine/package.json
COPY packages/mirofish/package.json packages/mirofish/package.json
COPY packages/storage/package.json packages/storage/package.json
RUN pnpm install --frozen-lockfile --prod --filter "worker..."
COPY packages packages
COPY apps/worker apps/worker
RUN mkdir -p /app/.data && chown -R node:node /app/.data
USER node
CMD ["pnpm","--filter","worker","start"]
