{
	admin off
	auto_https off
}

:8080 {
	@health {
		method GET HEAD
		path /health
	}
	handle @health {
		# Matching uses the cleaned path; the upstream must only ever see exactly /health here.
		rewrite * /health?
		reverse_proxy {$MIROFISH_UPSTREAM}
	}

	# An empty MIROFISH_TOKEN must never authorise a request.
	@authorized expression `"{$MIROFISH_TOKEN}" != "" && {http.request.header.X-MiroFish-Token} == "{$MIROFISH_TOKEN}"`
	handle @authorized {
		reverse_proxy {$MIROFISH_UPSTREAM} {
			transport http {
				read_timeout 900s
				write_timeout 900s
			}
		}
	}

	handle {
		header Content-Type application/json
		respond `{"success":false,"error":"unauthorized"}` 401
	}
}
