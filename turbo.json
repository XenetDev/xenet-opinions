{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "NEXT_PUBLIC_APP_URL",
    "MIROFISH_URL",
    "MIROFISH_TOKEN",
    "ENV_KEEPALIVE_MS",
    "ENV_SWEEP_INTERVAL_MS",
    "HEALTH_CHECK_MIROFISH",
    "DEMO_MODE",
    "DEMO_PAUSED",
    "DEMO_ALLOW_PAUSE",
    "MOCK_INTERVIEW_DELAY_MS",
    "MAX_RUNS_PER_DAY",
    "DEMO_MAX_ROUNDS",
    "STORAGE_DRIVER",
    "STORAGE_LOCAL_DIR",
    "S3_BUCKET",
    "S3_REGION",
    "S3_ENDPOINT",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "WORKER_POLL_MS",
    "MAX_CONCURRENT_RUNS",
    "WORKER_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
